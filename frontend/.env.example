# Copy to .env.local and fill in values before running
VITE_API_BASE_URL=http://localhost:5240/v1

# Dev auth mode — set to true to skip WorkOS entirely.
# Requires DevAuth:Enabled=true in API appsettings.Development.json.
# Remove this line (or set to false) when connecting to a real WorkOS tenant.
VITE_DEV_AUTH=true

# Required when VITE_DEV_AUTH is not true and VITE_AUTH_MODE is not set (WorkOS mode)
VITE_WORKOS_CLIENT_ID=client_XXXXX
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback

# Entra ID mode — alternative to WorkOS for self-hosted deployments with Azure AD.
# Set VITE_AUTH_MODE=entra and remove/unset VITE_DEV_AUTH to activate.
# See docs/deployment/local.md for setup instructions.
# VITE_AUTH_MODE=entra
# VITE_ENTRA_TENANT_ID=<directory-tenant-id-guid>
# VITE_ENTRA_CLIENT_ID=<application-client-id-guid>

# Optional — error tracking via Sentry. Leave blank in local dev.
# Create a project at https://sentry.io, copy the DSN from Project Settings → Client Keys.
VITE_SENTRY_DSN=

# Optional — Azure Application Insights. Leave blank in local dev.
# Copy the Connection String from your Application Insights resource → Overview → Connection String.
# Provides unified frontend + backend telemetry, dependency tracking, and live metrics in Azure Monitor.
VITE_APPINSIGHTS_CONNECTION_STRING=

# Optional — set by CI at build time for release tracking in Sentry and App Insights (e.g. git SHA).
VITE_APP_VERSION=

# CI-only secrets — never put these in .env.local or commit them.
# SENTRY_AUTH_TOKEN=     # Sentry internal integration token (source map upload)
# SENTRY_ORG=           # Your Sentry organisation slug
# SENTRY_PROJECT=       # Your Sentry project slug
