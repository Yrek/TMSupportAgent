{
  "name": "threat-modeling-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "generate:types": "openapi-typescript ../docs/api/openapi.yaml -o src/types/api.generated.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.10.1",
    "@dagrejs/dagre": "1.1.4",
    "@hookform/resolvers": "3.9.1",
    "@microsoft/applicationinsights-web": "3.4.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-tooltip": "1.1.6",
    "@sentry/react": "10.48.0",
    "@tanstack/react-query": "5.64.2",
    "@tanstack/react-query-devtools": "5.64.2",
    "@workos-inc/authkit-react": "0.16.1",
    "axios": "1.16.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.469.0",
    "mermaid": "11.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-dropzone": "14.3.5",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.14.0",
    "reactflow": "11.11.4",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/react": "4.10.2",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.59.1",
    "@sentry/vite-plugin": "5.2.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "25.6.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.3.0",
    "openapi-typescript": "7.4.4",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "rollup-plugin-visualizer": "5.12.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
