{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "tma-local",
        "Queues": [
          {
            "Name": "analysis-jobs",
            "Properties": {
              "DeadLetterOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "LockDuration": "PT5M",
              "MaxDeliveryCount": 5,
              "RequiresDuplicateDetection": false,
              "RequiresSession": false
            }
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  }
}
