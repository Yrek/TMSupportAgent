{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "WorkOS": {
    "ClientId": "",
    "Issuer": "https://api.workos.com",
    "JwksUri": "https://api.workos.com/.well-known/jwks.json"
  },

  "AzureStorage": {
    "AccountName": "",
    "ContainerName": "architectures"
  },

  "ApplicationInsights": {
    "ConnectionString": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
