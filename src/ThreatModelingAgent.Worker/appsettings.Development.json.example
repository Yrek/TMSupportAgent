  },

  "Classify": {
    "MaxSelectedMethods": 10
  },

  "StageMaxOutputTokens": {
    "Parse": 8192,
    "Normalize": 16000,
    "NormalizeEnrich": 16000,
    "Classify": 8192
  },

  "AnalyzeThrottling": {
    "MaxConcurrentMethods": 2,
    "DelayMsPerKChars": 50,
    "PreSynthesisDelayMs": 20000,
    "InputBudgetPerMethod": 50000,
    "MaxOutputTokens": 16000
  },

  "Synthesis": {
    "TokenCeiling": 200000,
    "MaxOutputTokens": 32000,
    "FrameworkMappingInputBudget": 30000,
    "FrameworkMappingMaxOutputTokens": 16000,
    "ReviewInputBudget": 20000,
    "ReviewMaxOutputTokens": 16000
  },

