{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AzureServiceBus": {
    "ConnectionString": "",
    "QueueName": "analysis-jobs"
  },

  "AzureStorage": {
    "AccountName": "",
    "ContainerName": "architectures"
  },

  "AzureOpenAI": {
    "Endpoint": ""
  },

  "LlmRouting": {
    "StrongModel": "gpt-5",
    "LowCostModel": "gpt-4o-mini"
  },

  "Classify": {
    "MaxSelectedMethods": 10
  },

  "StageMaxOutputTokens": {
    "Parse": 8192,
    "Normalize": 16000,
    "NormalizeEnrich": 16000,
    "Classify": 8192
  },

  "ApplicationInsights": {
    "ConnectionString": ""
  },

  "AnalyzeThrottling": {
    "MaxConcurrentMethods": 2,
    "DelayMsPerKChars": 50,
    "PreSynthesisDelayMs": 20000,
    "InputBudgetPerMethod": 50000,
    "MaxOutputTokens": 16000
  },

  "Synthesis": {
    "TokenCeiling": 200000,
    "MaxOutputTokens": 32000,
    "FrameworkMappingInputBudget": 30000,
    "FrameworkMappingMaxOutputTokens": 16000,
    "ReviewInputBudget": 20000,
    "ReviewMaxOutputTokens": 16000
  },

  "ModelPricing": {
    "Prices": {
      "gpt-5.1":         { "InputPerMToken": 2.00,  "OutputPerMToken": 8.00  },
      "gpt-5-mini":      { "InputPerMToken": 0.40,  "OutputPerMToken": 1.60  },
      "gpt-5":           { "InputPerMToken": 2.00,  "OutputPerMToken": 8.00  },
      "gpt-4o":          { "InputPerMToken": 2.50,  "OutputPerMToken": 10.00 },
      "gpt-4o-mini":     { "InputPerMToken": 0.15,  "OutputPerMToken": 0.60  },
      "claude-opus-4-7":           { "InputPerMToken": 15.00, "OutputPerMToken": 75.00 },
      "claude-sonnet-4-6":         { "InputPerMToken": 3.00,  "OutputPerMToken": 15.00 },
      "claude-haiku-4-5-20251001": { "InputPerMToken": 0.80,  "OutputPerMToken": 4.00  }
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
